# Serves the built single-page app inside the web container. TLS is the job of the proxy in front (infra/Caddyfile).
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build files never change, so they are cached for good; the service worker and the page must always be fetched again.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh path /sw.js /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	# A deep link such as /assignments/123 is a screen of the app, not a file.
	try_files {path} /index.html
	file_server
}
