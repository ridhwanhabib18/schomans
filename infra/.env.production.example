# Copy to infra/.env.production (git-ignored) and fill it in. Nothing here is a real secret; choose long random values.
# Two DNS records must point to the server before the first start: SITE_DOMAIN and AUTH_DOMAIN (both A/AAAA records).

# Addresses (no scheme)
SITE_DOMAIN=school.example.com
AUTH_DOMAIN=auth.school.example.com

# SQL Server (Express edition) and the login Keycloak gets in it
MSSQL_SA_PASSWORD=change-me-Str0ng!Passw0rd
KEYCLOAK_DB_PASSWORD=change-me-Another!Passw0rd

# Keycloak: the admin of the master realm, and the secret of the schomans-admin-api client (the API uses it to give a new student a role)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-Admin!Passw0rd
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-client-secret

# The fictional demo school: one-click demo logins and the seed data. The demo accounts share a public password, so a deployment
# with real data must set both to false and delete the demo users and the schomans-web-demo client in the realm.
DEMO_MODE=true
DEMO_PASSWORD=Demo123!
SEED_DEMO_DATA=true

# Cloudflare R2 (S3 API): create the buckets schomans-private and schomans-public, an API token with read and write on them, and a CORS
# rule on both that allows GET and PUT from https://SITE_DOMAIN. R2_PUBLIC_BASE_URL is the public address of schomans-public.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=https://pub-<id>.r2.dev

# AI: Mock costs nothing and is the default (ADR-004). Use Claude only with a key, and mind the budget caps (10 calls a day per user, USD 5 a month).
AI_PROVIDER=Mock
CLAUDE_API_KEY=

# Email: leave SMTP_HOST empty and the emails wait in the queue (nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@school.example.com
