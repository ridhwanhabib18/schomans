{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/schomans",
    "MetadataAddress": "",
    "Audience": "schomans-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "AllowedHosts": "*"
}
