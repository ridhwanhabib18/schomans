{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/schomans",
    "MetadataAddress": "",
    "Audience": "schomans-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "AllowedHosts": "*",
  "Storage": {
    "Endpoint": "",
    "BrowserEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "PrivateBucket": "schomans-private",
    "PublicBucket": "schomans-public",
    "PublicBaseUrl": "",
    "EnsureBuckets": false
  },
  "Site": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "RateLimiting": {
    "UploadsPerMinute": 30,
    "PublicPerMinute": 120
  }
}
